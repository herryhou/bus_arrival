# Keystore configuration for release builds
# Copy this file to keystore.properties and fill in the actual values
# DO NOT commit the actual keystore.properties file

# Path to the keystore file (relative to project root or absolute path)
storeFile=/path/to/release.keystore

# Keystore password
storePassword=your_keystore_password

# Key alias
keyAlias=your_key_alias

# Key password
keyPassword=your_key_password
